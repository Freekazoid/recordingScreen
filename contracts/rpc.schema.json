{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Freekazoid/recordingScreen/contracts/rpc.schema.json",
  "title": "ML worker JSON-RPC 2.0",
  "oneOf": [
    {
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": ["integer", "string", "null"] },
        "method": {
          "type": "string",
          "enum": [
            "hello",
            "asr.transcribe",
            "diarize.run",
            "speaker.embed",
            "models.status",
            "models.download",
            "cancel",
            "shutdown"
          ]
        },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["jsonrpc", "id"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": ["integer", "string", "null"] },
        "result": {},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string" },
            "data": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
