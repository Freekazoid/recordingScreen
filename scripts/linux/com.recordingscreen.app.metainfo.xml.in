<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.recordingscreen.app</id>
  <name>Screen Recorder</name>
  <summary>Запись экрана, звука и расшифровка</summary>
  <summary xml:lang="en">Screen recorder with speech transcription</summary>
  <developer id="github.com.freekazoid">
    <name>Freekazoid</name>
  </developer>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>Screen Recorder записывает экран, системный звук и микрофон, а затем расшифровывает речь и разделяет её по говорящим.</p>
    <p>Возможности:</p>
    <ul>
      <li>Запись всего экрана, выбранной области или окна.</li>
      <li>Системный звук и микрофон отдельными дорожками.</li>
      <li>Экспорт в MP4, MKV, WebM, AVI, MOV и FLV.</li>
      <li>Распознавание речи Whisper и диаризация sherpa-onnx.</li>
      <li>Очередь экспорта, история записей и работа из трея.</li>
    </ul>
  </description>
  <launchable type="desktop-id">screenrecorder.desktop</launchable>
  <pkgname>screenrecorder</pkgname>
  <url type="homepage">https://github.com/Freekazoid/recordingScreen</url>
  <url type="bugtracker">https://github.com/Freekazoid/recordingScreen/issues</url>
  <url type="vcs-browser">https://github.com/Freekazoid/recordingScreen</url>
  <categories>
    <category>AudioVideo</category>
    <category>Recorder</category>
  </categories>
  <keywords>
    <keyword>запись экрана</keyword>
    <keyword>захват экрана</keyword>
    <keyword>транскрипция</keyword>
    <keyword>диаризация</keyword>
    <keyword>screen recorder</keyword>
    <keyword>screen capture</keyword>
    <keyword>transcription</keyword>
    <keyword>diarization</keyword>
  </keywords>
  <icon type="stock">screenrecorder</icon>
  <provides>
    <binary>screenrecorder</binary>
  </provides>
  <releases>
    <release version="@VERSION@" date="@DATE@">
      <description>
        <p>Запись экрана, системного звука, распознавание речи и разделение говорящих.</p>
      </description>
    </release>
  </releases>
  <content_rating type="oars-1.1"/>
</component>
